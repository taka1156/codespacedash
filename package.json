{
  "name": "quotadash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "dev": "vite --port 5173",
    "analyze": "vite build --mode analyze",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "dev:pages": "vite --mode pages --port 5174",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-condition-coverage.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "vapid": "npx @pushforge/builder vapid"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@vanilla-extract/css": "^1.20.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.14.0",
    "hono": "^4.13.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.1",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "^5.1.2",
    "jsdom": "^31.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "8",
    "vitest": "^5.1.2",
    "wrangler": "^4.156.0"
  }
}
