{
  "name": "codespacedash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "dev": "vite --port 5173",
    "analyze": "vite build --mode analyze",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "vapid": "npx @pushforge/builder vapid"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@vanilla-extract/css": "^1.20.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "8",
    "wrangler": "^4.156.0"
  }
}
