{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codespacedash",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",

  // React のビルド成果物を配信。/api/* だけ Hono に回す
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // つけっぱなしチェック（15分ごと）
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // バージョンごとのプレビューURLは Access の対象外になりやすいので無効化
  "preview_urls": false,

  "observability": { "enabled": true },

  "kv_namespaces": [
    {
      "binding": "KV",
      // npx wrangler kv namespace create KV で作成したIDに置き換える
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "",
    "NOTIFY_AFTER_MIN": "60",
    "REMIND_EVERY_MIN": "60",
    "TIMEZONE": "Asia/Tokyo"
  }

  // Secrets（ここには書かない）:
  //   npx wrangler secret put GITHUB_TOKEN
  //   npx wrangler secret put VAPID_PRIVATE_JWK
}
